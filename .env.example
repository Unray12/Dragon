# ThingsBoard (self-hosted) — BI GITIGNORE, KHONG BAO GIO COMMIT FILE NAY
# Mau khong co gia tri: .env.example (file do moi duoc commit)

TB_HOST=https://dragonedenem.dsolution.net
TB_DEVICE_ID=

# Device access token: CHI de thiet bi PUSH telemetry len
# (POST /api/v1/{token}/telemetry). KHONG doc duoc timeseries.
TB_DEVICE_ACCESS_TOKEN=

# JWT tenant-admin — CHI dung de test/kham pha bang curl.
# Het han sau ~2.5h ke tu luc phat hanh, KHONG nhung vao app.
TB_JWT=

# App CAN cai nay (JWT het han, khong dung duoc): tao 1 Customer user chi doc device tren,
# roi dien vao day. App se tu POST /api/auth/login de lay JWT va tu refresh.
TB_USERNAME=
TB_PASSWORD=
